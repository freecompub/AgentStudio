{
  "name": "agent-studio",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "pnpm --filter @agent-studio/desktop build",
    "dev": "pnpm --filter @agent-studio/desktop dev",
    "ext:build": "tsx scripts/extension-tools.ts build",
    "ext:keys": "tsx scripts/extension-tools.ts keys",
    "ext:pack": "tsx scripts/extension-tools.ts pack",
    "smoke:copilot": "tsx scripts/smoke-copilot.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json && tsc -p apps/desktop/tsconfig.web.json"
  },
  "devDependencies": {
    "@agent-studio/core": "workspace:*",
    "@agent-studio/extension-host": "workspace:*",
    "@agent-studio/extension-packaging": "workspace:*",
    "@agent-studio/github-auth": "workspace:*",
    "@agent-studio/runtime-copilot": "workspace:*",
    "@agent-studio/workspace": "workspace:*",
    "@types/node": "^22.19.0",
    "eslint": "^10.11.0",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "vitest": "^4.1.11"
  }
}
