{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "types": [
      "node"
    ],
    "allowJs": true
  },
  "include": [
    "packages/*/src",
    "packages/*/test",
    "extensions/*/src",
    "extensions/*/test",
    "tests/*/test",
    "apps/desktop/src/main",
    "apps/desktop/src/preload",
    "apps/desktop/src/shared",
    "apps/desktop/test",
    "scripts",
    "vitest.config.ts"
  ],
  "exclude": [
    "apps/desktop/test/renderer"
  ]
}
